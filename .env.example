# Required
DATABASE_URL=postgres://board:board@localhost:5432/board
# Optional when the local `claude` CLI is logged in; otherwise required.
ANTHROPIC_API_KEY=sk-ant-...
TARGET_REPO_PATH=/Users/me/agent-board-sample
BASE_BRANCH=main
WORKTREES_DIR=/Users/me/.agent-board/worktrees

# Optional
AGENT_MODEL=
AGENT_MAX_TURNS=60
# How many tickets may run at the same time (1-16). Each also needs a free worktree, so add worktrees to a project to use it.
AGENT_CONCURRENCY=3
# Default spending limit per ticket in USD (empty = no limit). Projects and tickets can set their own.
AGENT_MAX_BUDGET_USD=
# Time limit for a project's setup and check commands, and how often failing checks go back to the agent.
CHECK_TIMEOUT_MS=600000
AGENT_CHECK_RETRIES=2
AGENT_EXTRA_ALLOWED_TOOLS=Bash(npm test:*),Bash(node:*)
POLL_INTERVAL_MS=3000
API_PORT=3000
# Interface the API binds to. 127.0.0.1 = this machine only; 0.0.0.0 exposes it (set BOARD_TOKEN then).
API_HOST=127.0.0.1
# Optional shared secret (>= 16 chars, e.g. `openssl rand -hex 24`). Unset = no sign-in.
# When set, the UI asks for it once and keeps it in an HttpOnly cookie; scripts can send `Authorization: Bearer <token>`.
BOARD_TOKEN=
WEB_ORIGIN=http://localhost:5173
# Board URL used for links in webhook notifications (Settings -> Notifications)
PUBLIC_URL=http://localhost:5173
# Image attachments (S3-compatible; defaults match the MinIO service in docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shiftboard-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Test database used by backend integration tests
TEST_DATABASE_URL=postgres://board:board@localhost:5432/board_test
