{
  "name": "@agent-board/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "pnpm typeorm migration:generate"
  },
  "dependencies": {
    "@agent-board/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "3.1143.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
